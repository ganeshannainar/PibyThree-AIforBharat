# ============================================================
# FastAPI Ecommerce API - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.

# ------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------
db_username=ecommerce_user
db_password=your_db_password_here
db_hostname=localhost
db_port=5432
db_name=ecommerce_db

# ------------------------------------------------------------
# JWT Configuration
# ------------------------------------------------------------
secret_key=your-super-secret-key-change-in-production
algorithm=HS256
access_token_expire_minutes=30

# ------------------------------------------------------------
# Google / Gemini API
# ------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------
# AWS Configuration (for S3 uploads & Bedrock LLM)
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# LLM Model (AWS Bedrock - Claude)
LLM_MODEL_ID=your.bedrock.model.id

# ------------------------------------------------------------
# SerpAPI (Real-time price comparison)
# ------------------------------------------------------------
SERP_API_KEY=your_serp_api_key_here

# ------------------------------------------------------------
# LangChain / LangSmith Tracing (optional)
# ------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=your-project-name
LANGCHAIN_API_KEY=your_langchain_api_key_here

# ------------------------------------------------------------
# Langfuse Observability (optional)
# ------------------------------------------------------------
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
