# ================================
# FastAPI E-commerce API .gitignore
# ================================

# ===================
# Python
# ===================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ===================
# Virtual Environments
# ===================
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
env3.*
Pipfile.lock

# ===================
# Environment Variables
# ===================
.env
.env.local
.env.*.local
.env.development
.env.production
*.env

# ===================
# IDE / Editor
# ===================
# VSCode
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*~
.*.sw?
*.swp
*.swo
*.swn
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ===================
# Testing
# ===================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
nosetests.xml
test-results/
test-output/

# ===================
# Type Checking
# ===================
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# ===================
# Database
# ===================
# SQLite databases (for local testing)
*.db
*.sqlite
*.sqlite3
test.db

# PostgreSQL
*.pgsql

# ===================
# Alembic Migrations
# ===================
# Keep migration files tracked, but ignore auto-generated pycache
alembic/versions/__pycache__/

# ===================
# Logs
# ===================
*.log
log.txt
logs/
*.log.*

# ===================
# Documentation
# ===================
docs_build/
site_build/
site/
docs.zip
_build/

# ===================
# Archives
# ===================
*.zip
*.tar.gz
*.rar
archive.zip

# ===================
# Jupyter Notebooks
# ===================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ===================
# OS Generated
# ===================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ===================
# Deployment
# ===================
.netlify/
.vercel/
.serverless/

# ===================
# Misc
# ===================
.cache/
*.bak
*.tmp
*.temp
.secrets/

# ===================
# LangGraph Runtime State
# ===================
.langgraph_api/

# ===================
# Uploaded Media (keep directory structure)
# ===================
uploads/products/*
uploads/promotions/*
!uploads/products/.gitkeep
!uploads/promotions/.gitkeep

# ===================
# DB Backups
# ===================
db_backup/backups/*.sql
db_backup/backups/*.sql.gz

# ===================
# Docker (optional)
# ===================
# Uncomment if you don't want to track docker files
# docker-compose.override.yml
# .docker/